# https://nuxt.com/docs/4.x/guide/recipes/sessions-and-authentication#cookie-encryption-key
# IMPORTANT: Must be at least 32 characters for production
# Generate with: openssl rand -base64 32
NUXT_SESSION_PASSWORD=a-random-password-with-at-least-32-characters

# External API endpoint
# Local development: http://localhost:6060
# Production: Your actual backend API URL (e.g., https://api.yourdomain.com)
EXTERNAL_API_URL=http://localhost:6060

# Key visual editor version toggle
# false (default): use the current editor (Editor/Main.vue)
# true: use the new Canva-like editor (EditorV2/Main.vue)
NUXT_PUBLIC_EDITOR_V2_ENABLED=false